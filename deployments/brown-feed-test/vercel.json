{
  "buildCommand": "cd ../../.. && npm run build",
  "outputDirectory": "../../../dist",
  "installCommand": "cd ../../.. && npm install",
  "functions": {
    "../../../api/index.ts": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/themes", 
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
