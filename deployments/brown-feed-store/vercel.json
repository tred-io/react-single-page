{
  "version": 2,
  "name": "brown-feed-store-website",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "CLIENT_NAME": "brown-feed-store",
    "CLIENT_CONFIG_PATH": "./client-config.json"
  }
}
