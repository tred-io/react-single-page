    {
      "sha": "226519c374a2ea4fc2639a799403caccd78892ff",
      "filename": "client/src/App.tsx",
      "status": "added",
      "additions": 41,
      "deletions": 0,
      "changes": 41,
      "blob_url": "https://github.com/tred-io/brown-feed-store-website/blob/6fe982002affc7af287955dce36d381de7ba8c1c/client%2Fsrc%2FApp.tsx",
      "raw_url": "https://github.com/tred-io/brown-feed-store-website/raw/6fe982002affc7af287955dce36d381de7ba8c1c/client%2Fsrc%2FApp.tsx",
      "contents_url": "https://api.github.com/repos/tred-io/brown-feed-store-website/contents/client%2Fsrc%2FApp.tsx?ref=6fe982002affc7af287955dce36d381de7ba8c1c",
      "patch": "@@ -0,0 +1,41 @@\n+import { Switch, Route } from \"wouter\";\n+import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\n+import Home from \"./pages/Home\";\n+import AdminEnhanced from \"./pages/AdminEnhanced\";\n+import ThemeGeneratorPage from \"./pages/ThemeGeneratorPage\";\n+import NotFound from \"./pages/NotFound\";\n+\n+const queryClient = new QueryClient({\n+  defaultOptions: {\n+    queries: {\n+      queryFn: async ({ queryKey }) => {\n+        const response = await fetch(queryKey[0] as string);\n+        if (!response.ok) {\n+          throw new Error(`${response.status}: ${response.statusText}`);\n+        }\n+        return response.json();\n+      },\n+    },\n+  },\n+});\n+\n+function Router() {\n+  return (\n+    <Switch>\n+      <Route path=\"/\" component={Home} />\n+      <Route path=\"/admin\" component={AdminEnhanced} />\n+      <Route path=\"/themes\" component={ThemeGeneratorPage} />\n+      <Route component={NotFound} />\n+    </Switch>\n+  );\n+}\n+\n+function App() {\n+  return (\n+    <QueryClientProvider client={queryClient}>\n+      <Router />\n+    </QueryClientProvider>\n+  );\n+}\n+\n+export default App;"
    },
